# Module 10 runtime selection
MODULE10_MODE=local
MODULE10_HOST=127.0.0.1
MODULE10_PORT=8090
MODULE10_BEDROCK_MODEL_ID=us.openai.gpt-5.6-luna
# MODULE10_ARTIFACT_DIR=/absolute/path/to/recovery-plans

# Section 1 uses the normal AWS credential chain. Supply your own profile/region:
# AWS_PROFILE=<your-local-profile>
# AWS_REGION=<your-region>
# AWS_DEFAULT_REGION=<your-region>
# On AWS, use a workload role instead of a named local profile.

# Actual LaunchDarkly SDK file source; defaults to module10/flags.json
# MODULE10_LD_FILE=/absolute/path/to/module10-flags.json

# Later sections: MODULE10_MODE=live
MODULE10_MAX_COMPLETION_TOKENS=800
# MODULE10_REASONING_EFFORT=none
# Portkey hosted or self-hosted gateway
# PORTKEY_BASE_URL=http://127.0.0.1:<port>
# PORTKEY_API_KEY=<gateway-key>
# PORTKEY_CONFIG_ID=<config-id>
# PORTKEY_MODEL_ALIAS=deployment-reviewer
# PORTKEY_PRIMARY_TARGET=portkey-primary
# PORTKEY_FALLBACK_TARGET=portkey-fallback
#
# Configure the external Portkey route as:
#   deployment-reviewer -> GPT-5.6 Terra -> GPT-5.6 Luna

# Hosted LaunchDarkly
# LD_SDK_KEY=<server-sdk-key>
# LD_AGENT_VERSION_FLAG=module10-reviewer-variant
# LD_AGENT_ENABLED_FLAG=module10-reviewer-enabled

# Hosted Logz.io or local OTLP Collector
# OTEL_EXPORTER_OTLP_ENDPOINT=<otlp-traces-endpoint>
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <token>
